# Use official PostgreSQL 15 base image
FROM postgres:15

# Install build dependencies and pgvector
RUN apt-get update && \
    apt-get install -y git make gcc postgresql-server-dev-15 && \
    git clone https://github.com/pgvector/pgvector.git && \
    cd pgvector && \
    make && make install && \
    cd .. && rm -rf pgvector

# Expose default PostgreSQL port
EXPOSE 5432
