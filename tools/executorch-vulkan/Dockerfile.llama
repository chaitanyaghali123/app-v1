FROM python:3.11-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        glslc \
        ninja-build \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip \
    && python -m pip install --index-url https://download.pytorch.org/whl/cpu \
        "torch==2.10.0" \
    && python -m pip install \
        "executorch==1.1.0" \
        "huggingface-hub>=0.30,<2" \
        "safetensors>=0.5,<1" \
        "torchtune>=0.6,<1"

# ExecuTorch 1.1 accepts force_fp16 for Vulkan but its LLM helper rejects an
# already-FP16 eager graph. Keeping the eager graph FP16 is required to export
# this model on an 8 GB development machine.
RUN python -c "from pathlib import Path; p=Path('/usr/local/lib/python3.11/site-packages/executorch/extension/llm/export/partitioner_lib.py'); s=p.read_text(); old='    assert (\n        dtype_override == \"fp32\" or dtype_override is None\n    ), \"Vulkan backend does not support non fp32 dtypes at the moment\"\n'; assert old in s; p.write_text(s.replace(old, ''))"

# Vulkan qcs8w publishes FP32 compute shaders while force_fp16 controls compact
# serialized storage. Upcast only after PT2E has converted the large linear
# weights to int8, avoiding the memory spike of an eager FP32 checkpoint.
RUN python -c "from pathlib import Path; p=Path('/usr/local/lib/python3.11/site-packages/executorch/extension/llm/export/builder.py'); s=p.read_text(); old='                m = convert_pt2e(m)\n'; new='                m = convert_pt2e(m).to(dtype=torch.float32)\n                for node in m.graph.nodes:\n                    if node.op == \"call_function\" and node.target == torch.ops.aten._assert_tensor_metadata.default:\n                        args = list(node.args)\n                        if len(args) > 3 and args[3] == torch.float16:\n                            args[3] = torch.float32\n                            node.args = tuple(args)\n                m.recompile()\n'; assert old in s; p.write_text(s.replace(old, new, 1))"

# ExecuTorch 1.1's Vulkan prepack pass may inspect non-delegated boundary ops.
# Treat those operators as not owning prepacking instead of indexing a missing
# registry entry (for example aten::index.Tensor in Llama's attention mask).
RUN python -c "from pathlib import Path; p=Path('/usr/local/lib/python3.11/site-packages/executorch/backends/vulkan/op_registry.py'); s=p.read_text(); old='def handles_own_prepacking(target: OpKey) -> bool:\n    return get_op_features(target).supports_prepacking\n'; new='def handles_own_prepacking(target: OpKey) -> bool:\n    if not has_impl(target):\n        return False\n    return get_op_features(target).supports_prepacking\n'; assert old in s; p.write_text(s.replace(old, new, 1))"

WORKDIR /workspace

COPY export_llama_vulkan.py /opt/export_llama_vulkan.py

ENTRYPOINT ["python", "/opt/export_llama_vulkan.py"]
